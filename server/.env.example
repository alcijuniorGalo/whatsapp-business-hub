# ============================================================
# WhatsApp Business Hub — Webhook Server
# Copie para `.env` e preencha. NUNCA commite o `.env`.
#   cp .env.example .env
# ============================================================

# Token de verificação do webhook (você inventa; o MESMO valor vai no
# painel da Meta em WhatsApp > Configuration > Webhook > Verify Token).
VERIFY_TOKEN=troque-por-uma-frase-secreta

# Access token da Cloud API (Meta Developers > seu app > WhatsApp > API Setup).
# Para produção, use o token de System User (dura 60 dias).
WA_TOKEN=cole-seu-access-token-aqui

# Versão da Graph API (ex: v21.0). Só mude se a Meta anunciar depreciação.
GRAPH_VERSION=v21.0

# Caminho do JSON da conta de serviço do Firebase (para enviar push via FCM).
# Baixe em: Firebase Console > Configurações > Contas de serviço > Gerar nova chave.
FIREBASE_SA=./sa.json

# Porta local do servidor (o ngrok/docker expõe essa porta).
PORT=3000
